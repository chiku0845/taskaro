PORT=3010
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3010
DB_FILE=./database/taskaro.sqlite
# Optional: exact account email allowed to send broadcast announcements
ADMIN_EMAIL=

# Email OTP + password reset (Gmail: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=taskaro <your-email@gmail.com>

# Optional Google OAuth. Configure the callback URL in Google Cloud Console:
# http://localhost:3010/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional OpenAI-compatible AI endpoint; if absent, rule-based assistant is used.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
